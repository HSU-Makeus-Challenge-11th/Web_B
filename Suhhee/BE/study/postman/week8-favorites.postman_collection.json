{
  "info": {
    "name": "UMC 8주차 - 즐겨찾기와 영화 기록 필수 미션",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.info.iteration===0 && pm.info.requestName.startsWith('01 ')) pm.collectionVariables.set('stamp',Date.now().toString().slice(-7));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 회원 A 가입",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a{{stamp}}@week8.test\",\n  \"nickname\": \"솔A{{stamp}}\",\n  \"password\": \"Week8!pass\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const data=pm.response.json();",
              "pm.test('공통 응답',()=>{pm.expect(data).to.have.keys('isSuccess','code','message','result');pm.expect(data.isSuccess).to.eql(true);});",
              "pm.collectionVariables.set('memberA',data.result.memberId);"
            ]
          }
        }
      ]
    },
