    {
      "name": "18 payload 한 글자 변조 · 401",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const parts = pm.collectionVariables.get(\"tokenA\").split(\".\");",
              "const index = 8;",
              "parts[1] = parts[1].slice(0,index) + (parts[1][index] === \"a\" ? \"b\" : \"a\") + parts[1].slice(index+1);",
              "pm.collectionVariables.set(\"tamperedToken\", parts.join(\".\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"code AUTH401_3\", () => pm.expect(pm.response.json().code).to.eql(\"AUTH401_3\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tamperedToken}}"
          }
        ],
        "url": "{{baseUrl}}/members/me"
      }
