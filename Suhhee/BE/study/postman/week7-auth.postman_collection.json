  "item": [
    {
      "name": "01 회원 A 가입",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const run = Date.now().toString().slice(-7);",
              "pm.collectionVariables.set(\"emailA\", \"a\" + run + \"@umc.test\");",
              "pm.collectionVariables.set(\"emailB\", \"b\" + run + \"@umc.test\");",
              "pm.collectionVariables.set(\"nickA\", \"솔A\" + run);",
              "pm.collectionVariables.set(\"nickB\", \"솔B\" + run);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"code COMMON201\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON201\"));",
              "pm.collectionVariables.set(\"memberA\", pm.response.json().result.memberId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{emailA}}\", \"nickname\": \"{{nickA}}\", \"password\": \"Week7!pass\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
